{
  "name": "@vipintom/vstack-opencode",
  "version": "0.1.0",
  "description": "vstack OpenCode Runtime Plugin — workflow engine, agents, tools, projections for OpenChamber",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
