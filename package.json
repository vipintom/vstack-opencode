{
  "name": "@vipintom/vstack-opencode",
  "version": "0.2.1",
  "description": "vstack recorder for OpenCode: six tools, .vstack state and enforced delivery transitions",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
