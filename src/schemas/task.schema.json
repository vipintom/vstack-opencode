{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vstack.dev/schemas/task.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "deliveryId",
    "phaseRunId",
    "title",
    "description",
    "type",
    "status",
    "priority",
    "dependencies",
    "assignedAgentId",
    "assignedSessionId",
    "workScope",
    "acceptanceCriteria",
    "expectedOutputs",
    "requiredSkills",
    "worktreePath",
    "attemptCount",
    "maxAttempts",
    "resultSummary",
    "evidenceIds",
    "blocker",
    "revision",
    "createdAt",
    "updatedAt",
    "completedAt",
    "startedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^tsk_[a-zA-Z0-9_-]+$" },
    "deliveryId": { "type": "string", "pattern": "^del_[a-zA-Z0-9_-]+$" },
    "phaseRunId": { "type": "string", "pattern": "^phrun_[a-zA-Z0-9_-]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["discovery", "design", "planning", "implementation", "testing", "review", "documentation", "release", "deployment", "operations", "other"] },
    "status": { "type": "string", "enum": ["pending", "ready", "assigned", "in_progress", "review", "completed", "blocked", "failed", "cancelled", "skipped", "needs_rework"] },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^tsk_[a-zA-Z0-9_-]+$" } },
    "assignedAgentId": { "type": ["string", "null"], "pattern": "^vstack-(lead|architect|developer|test-engineer|reviewer|operator)$" },
    "assignedSessionId": { "type": ["string", "null"] },
    "workScope": { "type": "string" },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "expectedOutputs": { "type": "array", "items": { "type": "string" } },
    "requiredSkills": { "type": "array", "items": { "type": "string", "pattern": "^vstack-" } },
    "worktreePath": { "type": ["string", "null"] },
    "attemptCount": { "type": "integer", "minimum": 0 },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "resultSummary": { "type": ["string", "null"] },
    "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^evd_[a-zA-Z0-9_-]+$" } },
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["dependency", "external", "resource", "approval", "technical", "other"] },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" },
        "at": { "type": "string", "format": "date-time" },
        "blockingTaskIds": { "type": "array", "items": { "type": "string", "pattern": "^tsk_[a-zA-Z0-9_-]+$" } }
      },
      "required": ["type", "message", "at"]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}