{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vstack.dev/schemas/finding.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "deliveryId",
    "reviewRunId",
    "reviewerAgentId",
    "lens",
    "severity",
    "category",
    "title",
    "explanation",
    "filePath",
    "lineRange",
    "reproducibility",
    "recommendation",
    "status",
    "owner",
    "remediationTaskId",
    "resolutionEvidenceIds",
    "firstSeenReviewRunId",
    "lastReviewedReviewRunId",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^fnd_[a-zA-Z0-9_-]+$" },
    "deliveryId": { "type": "string", "pattern": "^del_[a-zA-Z0-9_-]+$" },
    "reviewRunId": { "type": "string", "pattern": "^revrun_[a-zA-Z0-9_-]+$" },
    "reviewerAgentId": { "type": "string", "const": "vstack-reviewer" },
    "lens": { "type": "string", "enum": ["correctness_regression", "architecture_design", "security_data", "performance_resources", "maintainability_style", "test_adequacy", "documentation_migration"] },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
    "category": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "explanation": { "type": "string", "minLength": 1 },
    "filePath": { "type": ["string", "null"] },
    "lineRange": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      },
      "required": ["start", "end"]
    },
    "reproducibility": { "type": ["string", "null"] },
    "recommendation": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["open", "accepted", "fixed", "false_positive", "deferred"] },
    "owner": { "type": ["string", "null"] },
    "remediationTaskId": { "type": ["string", "null"], "pattern": "^tsk_[a-zA-Z0-9_-]+$" },
    "resolutionEvidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^evd_[a-zA-Z0-9_-]+$" } },
    "firstSeenReviewRunId": { "type": "string", "pattern": "^revrun_[a-zA-Z0-9_-]+$" },
    "lastReviewedReviewRunId": { "type": ["string", "null"], "pattern": "^revrun_[a-zA-Z0-9_-]+$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}