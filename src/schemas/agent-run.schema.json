{
  "$schema": "http://json.schemastore.org/draft-07/schema#",
  "$id": "https://vstack.dev/schemas/agent-run.json",
  "title": "AgentRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "deliveryId",
    "taskId",
    "agentId",
    "sessionId",
    "worktreePath",
    "status",
    "dispatchPrompt",
    "contextReferences",
    "startedAt",
    "completedAt",
    "resultSummary",
    "error",
    "revision"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^agrun_[a-zA-Z0-9_-]+$" },
    "deliveryId": { "type": "string", "pattern": "^del_[a-zA-Z0-9_-]+$" },
    "taskId": { "type": ["string", "null"], "pattern": "^tsk_[a-zA-Z0-9_-]+$" },
    "agentId": { "type": "string", "pattern": "^vstack-(lead|architect|developer|test-engineer|reviewer|operator)$" },
    "sessionId": { "type": "string", "minLength": 1 },
    "worktreePath": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["dispatched", "running", "completed", "failed", "cancelled"] },
    "dispatchPrompt": { "type": "string", "minLength": 1 },
    "contextReferences": { "type": "array", "items": { "type": "string" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "resultSummary": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 1 }
  }
}