{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vstack.dev/schemas/manifest.json",
  "title": "Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vstackVersion",
    "contentVersion",
    "projectId",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "vstackVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?$" },
    "contentVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?$" },
    "projectId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}